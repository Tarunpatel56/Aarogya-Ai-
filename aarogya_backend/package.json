{
  "name": "aarogya-backend",
  "version": "1.0.0",
  "description": "Shared Backend Service for Aarogya Healthcare Ecosystem",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/scripts', 'dist/scripts', {recursive: true})\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "bootstrap:superadmin": "tsx src/scripts/bootstrap_superadmin.ts",
    "verify:doctor": "tsx src/scripts/verify_doctor.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "aarogya",
    "healthcare",
    "telehealth",
    "express",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "author": "Aarogya Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "@types/socket.io": "^3.0.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "prisma": "^6.4.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
