# ==============================================================================
# Aarogya Backend Environment Configuration Template
# ==============================================================================
# - Copy this file to .env and configure your local or deployment secrets.
# - Never commit your real .env file or credentials to source control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/aarogya_db?schema=public"

# Cross-Origin Resource Sharing (CORS) Configuration
CORS_ORIGIN="*"

# Authentication & JWT Configuration
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRY="30d"
JWT_REFRESH_EXPIRY="60d"

# ------------------------------------------------------------------------------
# 1. AI Inference Services (Gemini, Groq, Grok)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROK_API_KEY="your_grok_or_groq_api_key_here"
MEDICAL_AI_PROVIDER="gemini" # Modular switch: "gemini" | "groq" | "custom_ml"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# ------------------------------------------------------------------------------
# 2. Google Places API (New)
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY="AIzaSy_your_google_places_api_key_here"
GOOGLE_PLACES_BASE_URL="https://places.googleapis.com/v1"

# ------------------------------------------------------------------------------
# 3. Ayushman Bharat Digital Mission (ABDM) Gateway & Sandbox APIs
# ------------------------------------------------------------------------------
ABDM_CLIENT_ID="SBX_002931"
ABDM_CLIENT_SECRET="aarogya_abdm_sandbox_secret_2026"
ABDM_BASE_URL="https://dev.abdm.gov.in/gateway"

# ------------------------------------------------------------------------------
# 4. e-RaktKosh National Blood Bank API
# ------------------------------------------------------------------------------
ERAKTKOSH_API_KEY="eraktkosh_open_health_api_key_2026"
ERAKTKOSH_BASE_URL="https://www.eraktkosh.in/BLDAHIMS/bloodbank"

# ------------------------------------------------------------------------------
# 5. Pradhan Mantri Bhartiya Janaushadhi Pariyojana (PMBJP) Generic Medicines API
# ------------------------------------------------------------------------------
PMBJP_API_KEY="pmbjp_public_catalog_key"
PMBJP_BASE_URL="http://janaushadhi.gov.in/api"

# ------------------------------------------------------------------------------
# 6. Ayushman Bharat PM-JAY Beneficiary Verification API
# ------------------------------------------------------------------------------
PMJAY_API_KEY="pmjay_national_health_authority_key"
PMJAY_BASE_URL="https://pmjay.gov.in/api"

# ------------------------------------------------------------------------------
# 7. Hosted Medical AI Inference APIs (Hugging Face / Custom endpoints)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY="hf_your_huggingface_token_here"
MRI_AI_API_URL="https://api-inference.huggingface.co/models/Hemgg/brain-tumor-classification"
MRI_AI_API_KEY=""
MRI_AI_MODEL="Hemgg/brain-tumor-classification"

LUNG_AI_API_URL="https://api-inference.huggingface.co/models/dima806/chest_xray_pneumonia_detection"
LUNG_AI_API_KEY=""
LUNG_AI_MODEL="dima806/chest_xray_pneumonia_detection"

SKIN_AI_API_URL="https://api-inference.huggingface.co/models/Tanishq77/skin-condition-classifier"
SKIN_AI_API_KEY=""
SKIN_AI_MODEL="Tanishq77/skin-condition-classifier"
