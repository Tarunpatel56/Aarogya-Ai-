# ==========================================
# Aarogya Backend - .gitignore
# ==========================================

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
secrets.json
credentials.json
service-account*.json
*.pem
*.key
*.cert

# --- Python Environments & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Python Distribution & Packaging ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Coverage ---
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/

# --- Node.js / JavaScript (if fullstack / microservices) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak
yarn.lock.bak

# --- AI Models, Weights & Datasets ---
*.onnx
*.pt
*.pth
*.bin
*.h5
*.tflite
models/checkpoints/
models/weights/
datasets/raw/
cache/

# --- Databases & Local Storage ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
data/
uploads/
storage/
temp/
tmp/

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
*.log
