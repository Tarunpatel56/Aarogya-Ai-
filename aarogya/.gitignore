# ==========================================
# Aarogya (Patient App) - .gitignore
# ==========================================

# --- Environment & Sensitive Secret Files ---
.env
.env.*
!.env.example
*.env
secrets.json
credentials.json
service-account*.json
firebase_options_prod.dart
jwt_secret*.key
*.pem
*.key

# --- Android Keystores & Local Properties ---
/android/local.properties
key.properties
*.jks
*.keystore
*.p12

# --- iOS & macOS Signing & Certificates ---
*.mobileprovision
*.cer
*.cert
*.p8
AuthKey_*.p8

# --- Miscellaneous & OS ---
*.class
*.log
*.pyc
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/

# --- IntelliJ / Android Studio ---
*.iml
*.ipr
*.iws
.idea/

# --- VS Code ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Flutter / Dart / Pub related ---
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# --- Symbolication & Obfuscation ---
app.*.symbols
app.*.map.json

# --- Android Native Build & Caches ---
/android/.gradle/
/android/app/debug
/android/app/profile
/android/app/release

# --- iOS & macOS Native Build & Ephemeral ---
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Pods/
**/macos/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Flutter/Generated.xcconfig

# --- Windows & Linux Ephemeral ---
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# --- Widget Preview related ---
.widget_preview/
